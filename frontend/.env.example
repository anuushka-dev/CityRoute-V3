# Frontend environment
#
# No .env file is required. API access is resolved by vite.config.js:
#   npm run dev   -> /api, proxied to the backend on port 8001 with the prefix
#                    stripped
#   npm run build -> same-origin API paths (the FastAPI process serves the built
#                    SPA and the API together)
#
# Docker builds can override the production prefix with a build arg:
#   docker build --build-arg VITE_API_PREFIX= .
#
# Backend origin used only by the Vite dev-server proxy.
VITE_API_ORIGIN=http://127.0.0.1:8001
